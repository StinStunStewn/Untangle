<!-- Settings Modal -->

<div class="modal-overlay" id="modalOverlay" onclick="closeModal(event)">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Settings</div>
      <button class="icon-btn" onclick="closeSettings()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="field" style="margin-bottom:16px">
      <div class="field-label">Anthropic API Key</div>
      <input type="password" class="input" id="apiKeyModal" placeholder="sk-ant-..." autocomplete="off" />
      <div class="notice">Stored locally in your browser. Used only to communicate with Anthropic's API.</div>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn-sm btn-primary" onclick="saveApiKeyModal()">Save key</button>
      <button class="btn-sm btn-ghost" onclick="clearApiKey()">Clear key</button>
    </div>
  </div>
</div>

<script>
  // State
  let images = [];
  let selectedLevel = 'steady';
  let tasks = [];
  let apiKey = localStorage.getItem('untangle_api_key') || '';
  let theme = localStorage.getItem('untangle_theme') || 'dark';

  // Init
  document.documentElement.setAttribute('data-theme', theme);
  if (apiKey) hideBanner();

  // Theme toggle
  document.getElementById('themeToggle').addEventListener('click', () => {
    theme = theme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('untangle_theme', theme);
  });

  // Settings modal
  document.getElementById('settingsBtn').addEventListener('click', () => {
    document.getElementById('apiKeyModal').value = apiKey;
    document.getElementById('modalOverlay').classList.add('open');
  });

  function closeSettings() {
    document.getElementById('modalOverlay').classList.remove('open');
  }

  function closeModal(e) {
    if (e.target === document.getElementById('modalOverlay')) closeSettings();
  }

  function saveApiKey() {
    const val = document.getElementById('apiKeyInline').value.trim();
    if (!val) return;
    apiKey = val;
    localStorage.setItem('untangle_api_key', val);
    hideBanner();
    checkReady();
  }

  function saveApiKeyModal() {
    const val = document.getElementById('apiKeyModal').value.trim();
    if (!val) return;
    apiKey = val;
    localStorage.setItem('untangle_api_key', val);
    hideBanner();
    checkReady();
    closeSettings();
  }

  function clearApiKey() {
    apiKey = '';
    localStorage.removeItem('untangle_api_key');
    document.getElementById('apiBanner').classList.remove('hidden');
    checkReady();
    closeSettings();
  }

  function hideBanner() {
    document.getElementById('apiBanner').classList.add('hidden');
  }

  // Level selector
  function setLevel(btn) {
    document.querySelectorAll('.level-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedLevel = btn.dataset.level;
  }

  // Breaks
  document.getElementById('breaksSelect').addEventListener('change', function() {
    document.getElementById('customBreakField').style.display =
      this.value === 'custom' ? 'flex' : 'none';
  });

  // File handling
  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput');

  fileInput.addEventListener('change', e => addFiles(e.target.files));
  document.getElementById('cameraInput').addEventListener('change', e => addFiles(e.target.files));

  const cameraInput = document.getElementById('cameraInput');
  cameraInput.addEventListener('change', e => addFiles(e.target.files));

  dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('drag-over');
  });

  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));

  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    addFiles(e.dataTransfer.files);
  });

  function addFiles(files) {
    Array.from(files).forEach(file => {
      if (!file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = e => {
        images.push({ src: e.target.result, file, id: Date.now() + Math.random() });
        renderGrid();
        checkReady();
      };
      reader.readAsDataURL(file);
    });
  }

  function removeImage(id) {
    images = images.filter(img => img.id !== id);
    renderGrid();
    checkReady();
  }

  function renderGrid() {
    const grid = document.getElementById('imageGrid');
    if (images.length === 0) { grid.innerHTML = ''; return; }

    grid.innerHTML = images.map(img => `
      <div class="image-thumb">
        <img src="${img.src}" alt="Uploaded space" />
        <button class="image-thumb-remove" onclick="removeImage(${img.id})" aria-label="Remove image">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    `).join('') + `
      <button class="add-more-btn">
        <input type="file" accept="image/*" multiple onchange="addFiles(this.files)" />
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add more
      </button>
    `;
  }

  function checkReady() {
    const ready = images.length > 0 && apiKey;
    document.getElementById('generateBtn').disabled = !ready;
  }

  // Compress image before sending
  function compressImage(dataUrl, maxWidth = 640) {
    return new Promise(resolve => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let w = img.width, h = img.height;
        if (w > maxWidth) { h = Math.round(h * maxWidth / w); w = maxWidth; }
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', 0.6));
      };
      img.src = dataUrl;
    });
  }

  // Build prompt
  function buildPrompt() {
    const hours = parseInt(document.getElementById('timeHours').value) || 0;
    const mins = parseInt(document.getElementById('timeMinutes').value) || 0;
    const totalTime = hours * 60 + mins;
    const breaksVal = document.getElementById('breaksSelect').value;
    const body = document.getElementById('bodyInput').value.trim();
    const nogo = document.getElementById('nogoInput').value.trim();
    const customBreak = document.getElementById('customBreak').value.trim();

    const breakText = breaksVal === 'custom' ? customBreak :
      breaksVal === 'none' ? 'no breaks' :
      breaksVal === 'short' ? '5-minute breaks every 25 minutes' :
      breaksVal === 'regular' ? '10-minute breaks every 30 minutes' :
      '10-minute breaks every 20 minutes';

    const levelDescriptions = {
      haze: 'very low energy and cognitive bandwidth today — use large, simple steps with minimal decisions required',
      steady: 'moderate energy — use clear, reasonably-sized tasks without overwhelming detail',
      clear: 'good focus available — can handle more granular, specific steps',
      sharp: 'full bandwidth — can handle detailed, thorough task breakdowns'
    };

    return `You are a compassionate, practical assistant helping someone tidy and organise their space. The person may have ADHD, depression, or executive function challenges. Your tone should be warm, non-judgmental, and encouraging without being condescending.

Analyse the provided image(s) of the space and generate a structured task plan.

SESSION PARAMETERS:
- Time available: ${totalTime > 0 ? `${totalTime} minutes` : 'flexible'}
- Break schedule: ${breakText}
- Energy level: ${selectedLevel} — ${levelDescriptions[selectedLevel]}
${body ? `- Bodily considerations: ${body}` : ''}
${nogo ? `- Tasks to avoid entirely: ${nogo}` : ''}

INSTRUCTIONS:
1. Look at the image(s) carefully and identify what needs to be done.
2. Create a realistic, time-aware task list that fits within the available time including breaks.
3. Order tasks by priority — quick wins first to build momentum.
4. Each task should have a clear action, an optional brief note of encouragement or clarification, and an estimated time in minutes.
5. Group tasks into phases if the session is longer than 30 minutes (e.g. "Phase 1 — Surface clear", "Phase 2 — Sort & organise").
6. If bodily considerations are given, adapt every relevant task accordingly.
7. Never include any task from the no-go list.
8. At the end, add one warm closing line — not motivational-poster generic, but something specific to what they accomplished.

Respond ONLY with valid JSON in this exact structure, no markdown, no preamble:
{
  "summary": "One sentence describing what you see and the overall plan",
  "totalEstimatedMinutes": number,
  "phases": [
    {
      "label": "Phase label or null if single phase",
      "tasks": [
        {
          "text": "Clear action description",
          "note": "Optional gentle note or null",
          "minutes": number
        }
      ]
    }
  ],
  "closing": "Warm specific closing line"
}`;
  }

  // Generate
  async function generate() {
    const btn = document.getElementById('generateBtn');
    const btnInner = document.getElementById('btnInner');
    const errorMsg = document.getElementById('errorMsg');

    btn.disabled = true;
    errorMsg.classList.remove('visible');
    btnInner.innerHTML = '<div class="spinner"></div> Reading your space...';

    try {
      const compressedImages = await Promise.all(images.map(img => compressImage(img.src)));
      const content = [
        ...compressedImages.map(dataUrl => ({
          type: 'image',
          source: { type: 'base64', media_type: 'image/jpeg', data: dataUrl.split(',')[1] }
        })),
        { type: 'text', text: buildPrompt() }
      ];

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 60000);
      let response;
      try {
        response = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          signal: controller.signal,
          headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
          body: JSON.stringify({
            model: 'claude-haiku-4-5-20251001',
            max_tokens: 1200,
            messages: [{ role: 'user', content }]
          })
        });
      } finally { clearTimeout(timeout); }

      if (!response.ok) {
        let errText = '';
        try { const err = await response.json(); errText = err.error?.message || JSON.stringify(err); } catch(e2) { errText = await response.text(); }
        throw new Error(`HTTP ${response.status}: ${errText}`);
      }

      const data = await response.json();
      const raw = data.content.map(c => c.text || '').join('');
      console.log('RAW RESPONSE:', raw);
      console.log('DATA:', JSON.stringify(data));
      const firstBrace = raw.indexOf('{');
      const lastBrace = raw.lastIndexOf('}');
      if (firstBrace === -1 || lastBrace === -1) throw new Error('No JSON in response. Raw: ' + raw.substring(0, 300));
      const clean = raw.substring(firstBrace, lastBrace + 1);
      let result;
      try { result = JSON.parse(clean); } catch(pe) { throw new Error('Parse failed: ' + pe.message + ' | Raw start: ' + raw.substring(0, 200)); }

      renderResults(result);
    } catch (e) {
      errorMsg.textContent = 'Error: ' + e.message;
      errorMsg.classList.add('visible');
    } finally {
      btn.disabled = false;
      btnInner.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"/></svg> Untangle this`;
      checkReady();
    }
  }

  function renderResults(result) {
    tasks = [];
    let taskId = 0;
    result.phases.forEach(phase => {
      phase.tasks.forEach(t => {
        tasks.push({ ...t, id: taskId++, done: false });
      });
    });

    const area = document.getElementById('resultsArea');
    area.innerHTML = '';

    const card = document.createElement('div');
    card.className = 'results-card';

    const totalTasks = tasks.length;
    const header = `
      <div class="results-header">
        <div>
          <div class="results-title">${result.summary}</div>
          <div class="results-meta">${result.totalEstimatedMinutes} min estimated &middot; ${totalTasks} tasks</div>
        </div>
        <div class="results-badge">${selectedLevel.charAt(0).toUpperCase() + selectedLevel.slice(1)}</div>
      </div>
      <div class="progress-bar-wrap"><div class="progress-bar-fill" id="progressFill" style="width:0%"></div></div>
    `;

    let taskHtml = '<div class="task-list" id="taskList">';
    let globalIdx = 0;

    result.phases.forEach((phase, pi) => {
      if (result.phases.length > 1 && phase.label) {
        taskHtml += `<div class="section-header">${phase.label}</div>`;
      }
      phase.tasks.forEach((t, ti) => {
        const idx = globalIdx++;
        taskHtml += `
          <div class="task-item" id="task-${idx}" onclick="toggleTask(${idx})" style="animation-delay:${idx * 0.06}s">
            <div class="task-check" id="check-${idx}">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"><polyline points="20,6 9,17 4,12"/></svg>
            </div>
            <div class="task-content">
              <div class="task-text" id="text-${idx}">${t.text}</div>
              ${t.note ? `<div class="task-note">${t.note}</div>` : ''}
            </div>
            <div class="task-duration">${t.minutes} min</div>
          </div>
        `;
      });
    });

    taskHtml += '</div>';

    const closing = `<div style="margin-top:20px;padding:16px;background:var(--accent-soft);border-radius:var(--radius-sm);font-size:13px;color:var(--text-secondary);font-style:italic;line-height:1.6">${result.closing}</div>`;
    const resetBtn = `<button class="reset-btn" onclick="resetSession()">Start a new session</button>`;

    card.innerHTML = header + taskHtml + closing + resetBtn;
    area.appendChild(card);

    card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function toggleTask(idx) {
    tasks[idx].done = !tasks[idx].done;
    const item = document.getElementById(`task-${idx}`);
    item.classList.toggle('done', tasks[idx].done);

    const done = tasks.filter(t => t.done).length;
    const pct = tasks.length > 0 ? (done / tasks.length) * 100 : 0;
    const fill = document.getElementById('progressFill');
    if (fill) fill.style.width = pct + '%';
  }

  function resetSession() {
    document.getElementById('resultsArea').innerHTML = '';
    images = [];
    renderGrid();
    checkReady();
    document.getElementById('bodyInput').value = '';
    document.getElementById('nogoInput').value = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>

</body>
</html>
